# ==========================================
# VaaniLink - Environment Configuration
# ==========================================

# -----------------
# Backend Settings
# -----------------
DJANGO_SECRET_KEY=change-this-to-a-secure-random-string-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
SECURE_SSL_REDIRECT=False

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://vaanilink:vaanilink_secure_password@localhost:5432/vaanilink

# Docker Compose DB Credentials
POSTGRES_DB=vaanilink
POSTGRES_USER=vaanilink
POSTGRES_PASSWORD=vaanilink_secure_password

# Cache & Channels (Redis)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Translation Engine
# Options: mock | rule_based | google_cloud | hybrid
TRANSLATION_ENGINE=hybrid
TRANSLATION_API_KEY=

# ------------------
# Frontend Settings
# ------------------
PORT=80
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
